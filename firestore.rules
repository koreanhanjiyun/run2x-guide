rules_version = '2';
// Run2X 설계 가이드 — Firestore 보안 규칙 (다중 팀)
// 역할: 개발자(isDev) / 팀 관리자(teams/{t}/members/{uid}.role == 'admin') / 팀원 / 로그인 사용자 / 비로그인
// 팀 데이터·팀 이름은 그 팀 팀원만. 가입은 팀 이름 + 비밀번호(열쇠)로. 팀 목록은 공개하지 않음.
service cloud.firestore {
  match /databases/{database}/documents {
    function signedIn() { return request.auth != null && request.auth.token.firebase.sign_in_provider == 'google.com'; }
    function uid() { return request.auth.uid; }
    function email() { return signedIn() && request.auth.token.email != null ? request.auth.token.email.lower() : ''; }
    // ▼ 개발자 이메일 (js/config.js 의 developers 와 같게)
    function isDev() { return email() in ['disguv1709@gmail.com']; }
    function mPath(t) { return /databases/$(database)/documents/teams/$(t)/members/$(uid()); }
    function isMember(t) { return signedIn() && exists(mPath(t)); }
    function isTAdmin(t) { return isMember(t) && get(mPath(t)).data.role == 'admin'; }
    // 파트 → 묶음. ※ js/app/status-shared.js 의 PGROUP 과 같게 (파트를 새로 만들면 두 곳 모두)
    function grpOf(part) { return part in ['프레임','서스','조향','제동','구동계','에어로','냉각'] ? '샤시'
                                : (part in ['모터컨트롤러','배터리','회로','데이터로거'] ? '전기' : ''); }
    // 팀장·파트장(같은 권한): 담당 파트(parts) 항목의 진행 상태·우리 팀 값만 편집.
    // 담당에 묶음(샤시·전기)이 있으면 그 묶음의 모든 파트, 팀장은 공통 항목도 편집
    function isLeadOf(t, part) { let m = get(mPath(t)).data; let ps = m.get('parts', []);
                                  return isMember(t) && m.role in ['head','lead'] && part is string
                                  && (ps.hasAny([part]) || ps.hasAny([grpOf(part)]) || (m.role == 'head' && part == '공통')); }
    function canEditPart(t, part) { return isTAdmin(t) || isLeadOf(t, part); }
    // 팀의 이번 시즌(meta/season). 지난 시즌 기록은 회장만 고침. 시즌을 정한 적이 없으면 제한 없음
    function sznPath(t) { return /databases/$(database)/documents/teams/$(t)/meta/season; }
    function isCurSeason(t, s) { return !exists(sznPath(t)) || string(get(sznPath(t)).data.season) == string(s); }
    function onlyCurKey(t, m) { return !exists(sznPath(t)) || m.keys().hasOnly([string(get(sznPath(t)).data.season)]); }
    function curKeyChange(t, a, b) { return !exists(sznPath(t)) || a.diff(b).affectedKeys().hasOnly([string(get(sznPath(t)).data.season)]); }
    function isBlocked(t) { return exists(/databases/$(database)/documents/teams/$(t)/blocked/$(uid())); }
    function str(v, n) { return v is string && v.size() <= n; }

    function tPath(t) { return /databases/$(database)/documents/teams/$(t); }
    function validName(n) { return n is string && n.matches('^[가-힣A-Za-z0-9 _-]{4,40}$'); }
    function isKey(k) { return k is string && k.matches('^[0-9a-f]{64}$'); }

    // 팀 이름 중복 방지: 소문자 이름 → 팀 ID. 존재 여부 확인(get)만 허용, 목록 조회 불가
    match /teamNames/{n} {
      allow get: if signedIn();
      allow create: if signedIn() && getAfter(tPath(request.resource.data.team)).data.name.lower() == n
                    && ( (!exists(tPath(request.resource.data.team)) && getAfter(tPath(request.resource.data.team)).data.createdBy == uid())
                         || isTAdmin(request.resource.data.team) );   // 팀 만들기 / 팀 이름 변경
      allow delete: if isTAdmin(resource.data.team);
    }
    // 가입 열쇠: SHA-256(소문자 팀 이름 + ':' + 비밀번호) → 팀 ID. 열쇠를 알아야(=비밀번호를 알아야) 읽을 수 있음
    match /joinKeys/{k} {
      allow get: if signedIn();
      allow create: if signedIn() && isKey(k) && getAfter(tPath(request.resource.data.team)).data.key == k
                    && ( (!exists(tPath(request.resource.data.team)) && getAfter(tPath(request.resource.data.team)).data.createdBy == uid())
                         || isTAdmin(request.resource.data.team) );
      allow delete: if isTAdmin(resource.data.team);
    }

    match /teams/{t} {
      allow read: if isMember(t);
      allow create: if signedIn() && request.resource.data.createdBy == uid() && validName(request.resource.data.name)
                    && isKey(request.resource.data.key)
                    && request.resource.data.keys().hasOnly(['name','createdBy','createdAt','key','lastActive'])
                    && getAfter(/databases/$(database)/documents/teamNames/$(request.resource.data.name.lower())).data.team == t;
      // 관리자: 비밀번호 변경(열쇠 교체)·팀 이름 변경(새 이름이 teamNames 에 이 팀으로 등록돼 있어야 함)
      allow update: if (isTAdmin(t) && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['key','name']) && isKey(request.resource.data.key)
                        && validName(request.resource.data.name)
                        && getAfter(/databases/$(database)/documents/teamNames/$(request.resource.data.name.lower())).data.team == t)
                    // 팀원 접속 시 마지막 활동일 기록 (2년 미접속 자동 삭제 기준)
                    || (isMember(t) && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['lastActive']) && request.resource.data.lastActive is string);
      allow delete: if isDev() || isTAdmin(t);

      // 팀원 명단
      match /members/{u} {
        allow read: if isMember(t) || (signedIn() && u == uid());
        allow create: if signedIn() && u == uid() && (
             // 팀을 만든 사람 = 첫 관리자 (팀 만들기와 같은 일괄 작업)
             (request.resource.data.role == 'admin' && !exists(tPath(t)) && getAfter(tPath(t)).data.createdBy == uid())
             // 비밀번호로 가입: 지금 유효한 열쇠를 가진 사람만
          || (request.resource.data.role == 'member' && isKey(request.resource.data.via) && !isBlocked(t)
              && exists(/databases/$(database)/documents/joinKeys/$(request.resource.data.via))
              && get(/databases/$(database)/documents/joinKeys/$(request.resource.data.via)).data.team == t) );
        // 회장: 역할(회장·팀장·파트장·팀원)·담당 파트·시즌 명단 변경
        allow update: if isTAdmin(t) && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['role','parts','seasons'])
                      && request.resource.data.role in ['admin','head','lead','member']
                      && request.resource.data.get('parts', []) is list && request.resource.data.get('parts', []).size() <= 16
                      && request.resource.data.get('seasons', {}) is map;
        // 회장은 다른 팀원을 내보낼 수 있고, 팀원·파트장은 스스로 나갈 수 있음. 회장 자신은 나갈 수 없음(팀 삭제 마지막 단계에서 팀 문서를 지운 뒤에만 자기 기록 삭제)
        allow delete: if (isTAdmin(t) && u != uid()) || (signedIn() && u == uid() && (resource.data.role != 'admin' || !exists(tPath(t))));
      }
      // 팀 데이터
      // 진행 상태·우리 팀 값: 회장 전부, 팀장·파트장은 문서의 part 가 담당 파트이고 팀의 이번 시즌 기록일 때 (쓰기 전·후 모두)
      match /status/{d} { allow read: if isMember(t);
        allow create: if isTAdmin(t) || (canEditPart(t, request.resource.data.get('part', null)) && isCurSeason(t, request.resource.data.get('season', '')));
        allow update: if isTAdmin(t) || (canEditPart(t, request.resource.data.get('part', null)) && canEditPart(t, resource.data.get('part', null))
                                         && isCurSeason(t, request.resource.data.get('season', '')) && isCurSeason(t, resource.data.get('season', '2026')));
        allow delete: if isTAdmin(t) || (canEditPart(t, resource.data.get('part', null)) && isCurSeason(t, resource.data.get('season', '2026'))); }
      match /val/{d}    { allow read: if isMember(t);
        allow create: if isTAdmin(t) || (canEditPart(t, request.resource.data.get('part', null)) && onlyCurKey(t, request.resource.data.get('s', {})));
        allow update: if isTAdmin(t) || (canEditPart(t, request.resource.data.get('part', null)) && (canEditPart(t, resource.data.get('part', null)) || !('part' in resource.data))
                                         && curKeyChange(t, request.resource.data.get('s', {}), resource.data.get('s', {})));
        allow delete: if isTAdmin(t); }
      match /meta/{d}   { allow read: if isMember(t); allow write: if isTAdmin(t); }
      // 팀 비밀번호 원문 (관리자만 보기·쓰기. 오픈채팅 입장 코드 수준으로 취급)
      match /secret/{d} { allow read, write: if isTAdmin(t); }
      // 차단한 사람: 다시 가입할 수 없음 (관리자가 관리, 본인은 자기 것만 확인)
      match /blocked/{u} {
        allow read: if isTAdmin(t) || (signedIn() && u == uid());
        allow create, delete: if isTAdmin(t);
      }
      // 항목별 논의 (댓글·답글). 작성자: 내용 수정·자기 글 삭제 표시 / 관리자: 부적절한 글 삭제
      match /qa/{id} {
        allow read: if isMember(t);
        allow create: if (isMember(t) && !isBlocked(t) && request.resource.data.by == uid() && str(request.resource.data.text, 4000)
                          && str(request.resource.data.item, 40)) || isTAdmin(t); // 관리자: 백업 불러오기
        allow update: if (isMember(t) && resource.data.by == uid() && !isBlocked(t)
                          && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['text','editedAt','removed'])
                          && str(request.resource.data.text, 4000) && (!('removed' in request.resource.data) || request.resource.data.removed == 'self'))
                      || (isTAdmin(t) && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['text','removed'])
                          && request.resource.data.removed == 'admin' && request.resource.data.text == '');
        allow delete: if isTAdmin(t) || (isMember(t) && resource.data.by == uid());
      }
    }

    // 표시 이름 (로그인 사용자끼리), 각자 자기 것만 씀
    match /profiles/{u} { allow read: if signedIn(); allow write: if signedIn() && u == uid(); }
    // 마지막으로 고른 팀
    match /users/{u}    { allow read, write: if signedIn() && u == uid(); }
    // 플랫폼 문의: 로그인 사용자 누구나 작성(차단된 계정 제외), 개발자만 읽기·처리 상태 변경·삭제
    match /feedback/{id} {
      allow create: if signedIn() && request.resource.data.by == uid() && str(request.resource.data.text, 4000)
                    && request.resource.data.status == '접수'
                    && !exists(/databases/$(database)/documents/fbBlocked/$(uid()));
      allow read, delete: if isDev();
      allow update: if isDev() && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['status'])
                    && request.resource.data.status in ['접수','검토 중','반영됨','반영 안 함'];
    }
    // 플랫폼 문의 차단 (개발자만 관리, 본인은 자기 것만 확인)
    match /fbBlocked/{u} {
      allow read: if isDev() || (signedIn() && u == uid());
      allow write: if isDev();
    }
    // 자동 삭제된 팀의 백업 (깃허브 작업만 씀, 개발자만 읽기)
    match /trash/{id} { allow read: if isDev(); }
    // 그 밖은 모두 거부 (예전 단일 팀 경로 status·val·qa·meta 포함)
    match /{path=**} { allow read, write: if false; }
  }
}
